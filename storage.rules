rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid) || isAdmin();
    }


    match /users/{uid}/media/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/videos/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/(mp4|quicktime|x-msvideo|webm)');
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /ai_inputs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
